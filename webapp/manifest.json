{
  "_version": "1.21.0",
  "sap.app": {
    "id": "datanub.translator",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "i18n": "i18n/i18n.properties",
    "dataSources": {
      "translationService": {
        "uri": "/sap/opu/odata/sap/ZGCP_TRANSLATION_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "datanub.translator.view.App",
      "type": "XML",
      "id": "appView",
      "async": true
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "datanub.translator.i18n.i18n"
        }
      },
      "odata": {
        "type": "sap.ui.model.odata.v2.ODataModel",
        "dataSource": "translationService",
        "preload": true,
        "settings": {
          "defaultBindingMode": "TwoWay",
          "defaultCountMode": "None"
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    }
  }
}
