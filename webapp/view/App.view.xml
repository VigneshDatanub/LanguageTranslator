<mvc:View
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    controllerName="datanub.translator.controller.App"
    displayBlock="true">

    <App id="app">
        <pages>
            <Page
                id="translatorPage"
                title="{i18n>pageTitle}"
                titleLevel="H1"
                showNavButton="false"
                class="sapUiResponsiveContentPadding">

                <!-- ======================================================= -->
                <!-- Main content: responsive grid layout                     -->
                <!-- ======================================================= -->
                <l:Grid
                    id="mainGrid"
                    defaultSpan="XL6 L6 M12 S12"
                    hSpacing="2"
                    class="sapUiLargeMarginTop">

                    <!-- ─────────────  INPUT PANEL  ───────────── -->
                    <Panel
                        id="inputPanel"
                        headerText="{i18n>panelInput}"
                        expandable="false"
                        expanded="true"
                        width="100%"
                        class="sapUiSmallMarginBottom">

                        <VBox class="sapUiSmallMargin">

                            <!-- Text input -->
                            <Label
                                id="labelInput"
                                text="{i18n>labelInputText}"
                                labelFor="inputTextArea"
                                required="true" />

                            <TextArea
                                id="inputTextArea"
                                value="{/inputText}"
                                placeholder="{i18n>placeholderInput}"
                                rows="8"
                                width="100%"
                                growing="true"
                                growingMaxLines="16"
                                class="sapUiSmallMarginBottom" />

                            <!-- Target language -->
                            <Label
                                id="labelLanguage"
                                text="{i18n>labelTargetLanguage}"
                                labelFor="languageSelect"
                                required="true" />

                            <ComboBox
                                id="languageSelect"
                                selectedKey="{/targetLanguage}"
                                width="100%"
                                busy="{/languagesBusy}"
                                showSecondaryValues="true"
                                filterSecondaryValues="true"
                                class="sapUiSmallMarginBottom"
                                items="{
                                    path: '/languages',
                                    sorter: { path: 'name', descending: false }
                                }">
                                <core:ListItem
                                    key="{code}"
                                    text="{name}"
                                    additionalText="{code}" />
                            </ComboBox>

                            <!-- Action buttons -->
                            <HBox
                                id="buttonBar"
                                class="sapUiSmallMarginTop"
                                alignItems="Center">

                                <Button
                                    id="btnTranslate"
                                    text="{i18n>btnTranslate}"
                                    type="Emphasized"
                                    icon="sap-icon://translate"
                                    press=".onTranslate"
                                    busy="{/busy}"
                                    enabled="{= !${/busy} }"
                                    class="sapUiSmallMarginEnd" />

                                <Button
                                    id="btnClear"
                                    text="{i18n>btnClear}"
                                    type="Default"
                                    icon="sap-icon://eraser"
                                    press=".onClear" />
                            </HBox>
                        </VBox>
                    </Panel>

                    <!-- ─────────────  OUTPUT PANEL  ───────────── -->
                    <Panel
                        id="outputPanel"
                        headerText="{i18n>panelOutput}"
                        expandable="false"
                        expanded="true"
                        width="100%"
                        visible="{= ${/translatedText} !== '' }">

                        <VBox class="sapUiSmallMargin">

                            <!-- Detected source language -->
                            <HBox
                                id="detectedLangBox"
                                alignItems="Center"
                                visible="{= ${/detectedSourceLanguage} !== '' }"
                                class="sapUiTinyMarginBottom">

                                <Label
                                    id="labelDetected"
                                    text="{i18n>labelDetectedSource}:"
                                    class="sapUiTinyMarginEnd" />

                                <Text
                                    id="detectedLangText"
                                    text="{/detectedSourceLanguage}" />
                            </HBox>

                            <!-- Translated text -->
                            <Label
                                id="labelOutput"
                                text="{i18n>labelTranslatedText}" />

                            <TextArea
                                id="outputTextArea"
                                value="{/translatedText}"
                                editable="false"
                                rows="8"
                                width="100%"
                                growing="true"
                                growingMaxLines="16" />

                            <!-- Save to SAP Button -->
                            <Button
                                id="btnSaveToSAP"
                                text="{i18n>btnSaveToSAP}"
                                type="Accept"
                                icon="sap-icon://save"
                                press=".onSaveToSAP"
                                class="sapUiSmallMarginTop" />
                        </VBox>
                    </Panel>
                </l:Grid>

                <!-- ─────────────  HISTORY PANEL  ───────────── -->
                <Panel
                    id="historyPanel"
                    headerText="{i18n>panelHistory}"
                    expandable="true"
                    expanded="true"
                    width="100%"
                    class="sapUiLargeMarginTop sapUiResponsiveMargin">
                    
                    <Table
                        id="historyTable"
                        items="{/allHistoryData}"
                        growing="true"
                        growingThreshold="5"
                        mode="None">
                        
                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="{i18n>historyTitle}" />
                                <ToolbarSpacer />
                                <SearchField id="searchField" liveChange=".onSearch" width="auto" placeholder="Search..." />
                                <MenuButton icon="sap-icon://excel-attachment" tooltip="Export">
                                    <menu>
                                        <Menu>
                                            <MenuItem text="Export Translation History" icon="sap-icon://excel-attachment" press=".onExport" />
                                        </Menu>
                                    </menu>
                                </MenuButton>
                                <Button icon="sap-icon://sort" press=".onOpenSortDialog" tooltip="Sort" type="Transparent" />
                                <Button icon="sap-icon://filter" press=".onOpenFilterDialog" tooltip="Filter" type="Transparent" />
                                <Button icon="sap-icon://refresh" press=".onRefreshHistory" tooltip="Refresh" type="Transparent" />
                            </OverflowToolbar>
                        </headerToolbar>
                        
                        <columns>
                            <Column width="10%"><Text text="ID (GuiNo)" /></Column>
                            <Column width="14%"><Text text="{i18n>colSourceText}" /></Column>
                            <Column width="14%"><Text text="{i18n>colTargetText}" /></Column>
                            <Column width="8%" hAlign="Center"><Text text="{i18n>colSourceLang}" /></Column>
                            <Column width="8%" hAlign="Center"><Text text="{i18n>colTargetLang}" /></Column>
                            <Column width="10%" hAlign="Center"><Text text="{i18n>colCreatedBy}" /></Column>
                            <Column width="12%" hAlign="Center"><Text text="Created On" /></Column>
                            <Column width="10%" hAlign="Center"><Text text="Time" /></Column>
                            <Column width="16%" hAlign="End"><Text text="{i18n>colActions}" /></Column>
                        </columns>
                        
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{GuiNo}" wrapping="true" />
                                    <Text text="{SrcText}" wrapping="true" />
                                    <Text text="{TarText}" wrapping="true" />
                                    <Text text="{SrcLang}" />
                                    <Text text="{TarLang}" />
                                    <Text text="{TransBy}" />
                                    <Text text="{
                                        path: 'TransOn',
                                        type: 'sap.ui.model.type.Date',
                                        formatOptions: { style: 'medium' }
                                    }" />
                                    <Text text="{
                                        path: 'TransAt',
                                        formatter: '.formatter.formatTime'
                                    }" />
                                    <HBox justifyContent="End">
                                        <Button icon="sap-icon://edit" type="Transparent" press=".onEditHistory" />
                                        <Button icon="sap-icon://delete" type="Transparent" press=".onDeleteHistory" />
                                    </HBox>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>

                </Panel>

                <!-- Busy indicator overlay during translation -->
                <dependents>
                    <BusyDialog
                        id="busyDialog"
                        title="Translating…"
                        text="Please wait while we translate your text."
                        showCancelButton="false" />
                </dependents>
            </Page>
        </pages>
    </App>
</mvc:View>
